# 複製成 .env 後再填入實際值：cp .env.example .env
# 不要把填好的 .env、cookies.txt 或 data/ 提交到 Git。

# --- 必填 ---
DISCORD_TOKEN=

# --- 面板 ---
# PUBLIC_URL=https://your-domain.example
# WEB_HOST=127.0.0.1
# WEB_PORT=5000
# WEB_THREADS=24
# ALLOWED_HOSTS=your-domain.example
# PANEL_SECRET=

# --- 機器人行為 ---
# FFMPEG_PATH=/usr/bin/ffmpeg
# DEFAULT_VOLUME=0.01
# EXT_TOKEN=
# OWNER_ID=
# SYNC_GUILD_ID=0
# QUEUE_MAX=
# IDLE_SLEEP_MINUTES=2
# AUTOPLAY_DEFAULT=0
# AUDIO_NORMALIZE=1
# BACKUP_INTERVAL_DAYS=7

# --- YouTube cookies 與紀錄（路徑請改成你的專案目錄）---
# YTDLP_COOKIES=/path/to/musicbot/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_PLAYER_CLIENT=
# HISTORY_DB=/path/to/musicbot/data/history.db
# ACTION_LOG_FILE=/path/to/musicbot/data/action_log.json

# --- 網頁 Discord 登入（選用）與自我檢查 ---
# DISCORD_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# OAUTH_REDIRECT_URI=https://your-domain.example/auth/discord/callback
# SELFCHECK_HOUR=9
# SELFCHECK_VIDEO=
