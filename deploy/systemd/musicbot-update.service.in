# Music Bot V6 — 每日更新 yt-dlp（由 musicbot-update.timer 觸發）
# 有人在聽就跳過；沒人在聽才更新，版本有變才重啟 bot（細節見 deploy/update-ytdlp.sh）
[Unit]
Description=Music Bot V6 - update yt-dlp (skip if anyone is listening; restart bot only if the version changed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# EXT_TOKEN（問本機面板有沒有人在聽）、WEB_PORT 從 .env 來
EnvironmentFile=-@APP_DIR@/.env
Environment=MUSICBOT_DIR=@APP_DIR@ MUSICBOT_PYTHON=@PYTHON@ MUSICBOT_USER=@RUN_USER@ MUSICBOT_SERVICE=musicbot.service
# 用 bash 執行：腳本沒有執行權限也能跑
ExecStart=/bin/bash @APP_DIR@/deploy/update-ytdlp.sh --restart-if-changed
TimeoutStartSec=30min
SyslogIdentifier=musicbot-update
