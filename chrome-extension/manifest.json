{
  "manifest_version": 3,
  "name": "音樂機器人點歌",
  "version": "1.1.1",
  "description": "在 YouTube / YouTube Music 一鍵把歌加入 Discord 音樂機器人（musbot.kdns.fr）的佇列。",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://musbot.kdns.fr/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "音樂機器人", "default_popup": "popup.html", "default_icon": "icon128.png" },
  "icons": { "48": "icon128.png", "128": "icon128.png" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
